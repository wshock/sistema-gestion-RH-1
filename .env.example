# Copiar este archivo a .env y completar los valores.
# cp .env.example .env

# Cadena de conexión a PostgreSQL usada por Prisma.
# Formato: postgresql://usuario:password@host:puerto/base_de_datos?schema=public
DATABASE_URL="postgresql://usuario:password@localhost:5432/sgrh?schema=public"

# Secreto usado por Auth.js para firmar/cifrar sesiones y tokens.
# Generar uno nuevo con: npx auth secret
AUTH_SECRET=""

# URL base de la aplicación. Requerida por Auth.js fuera de Vercel.
AUTH_URL="http://localhost:3000"

# Credenciales del primer usuario administrador, usadas solo por la carga
# inicial (npm run seed). La contraseña se guarda hasheada, nunca en claro.
SEED_ADMIN_EMAIL="admin@sgrh.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Administrador de RRHH"
